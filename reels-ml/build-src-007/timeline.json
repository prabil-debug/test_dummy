{
 "total": 56.7,
 "items": [
  {
   "sec": "hook",
   "text": "മൂന്നാം മാസം, ശമ്പളം പതിനഞ്ചാം തീയതി തന്നെ തീർന്നു.",
   "start": 0.2,
   "end": 2.9
  },
  {
   "sec": "hook",
   "text": "പൈസ എവിടെ പോയി?",
   "start": 3.15,
   "end": 4.2
  },
  {
   "sec": "s1",
   "text": "അതുകൊണ്ട് ഒരു ഗൂഗിൾ ഷീറ്റ് ഉണ്ടാക്കി, ഓരോ ചെലവും എഴുതി.",
   "start": 4.92,
   "end": 7.9
  },
  {
   "sec": "s1",
   "text": "ഷീറ്റിൽ നാല് കോളം:",
   "start": 8.22,
   "end": 9.46
  },
  {
   "sec": "s1",
   "text": "തീയതി, എന്ത്, എത്ര, ആവശ്യമോ ആഗ്രഹമോ.",
   "start": 9.83,
   "end": 12.3
  },
  {
   "sec": "s1",
   "text": "കഴിഞ്ഞ മാസവും ഈ മാസവും താരതമ്യം ചെയ്തു.",
   "start": 12.57,
   "end": 14.87
  },
  {
   "sec": "s2",
   "text": "വലിയ ചെലവൊന്നും ആയിരുന്നില്ല, കേട്ടോ.",
   "start": 15.6,
   "end": 17.25
  },
  {
   "sec": "s2",
   "text": "ചായ, ഓൺലൈൻ ഓർഡർ, സ്നാക്സ്.",
   "start": 17.54,
   "end": 19.55
  },
  {
   "sec": "s2",
   "text": "ചെറിയ ചെലവുകൾ കൂടിക്കൂടി വലുതായി.",
   "start": 19.93,
   "end": 21.46
  },
  {
   "sec": "s3",
   "text": "വാടക, ഭക്ഷണം, യാത്ര ആവശ്യം.",
   "start": 22.2,
   "end": 24.02
  },
  {
   "sec": "s3",
   "text": "ബാക്കി പലതും ആഗ്രഹം.",
   "start": 24.4,
   "end": 25.62
  },
  {
   "sec": "s3",
   "text": "ആവശ്യം അൻപത്, ആഗ്രഹം മുപ്പത്, സേവിങ്സ് ഇരുപത്.",
   "start": 25.98,
   "end": 29.04
  },
  {
   "sec": "s3",
   "text": "ഇതൊരു പൊതുവായ രീതിയാണ്, എൻ്റെ ശമ്പളത്തിൽ അങ്ങനെ പറ്റില്ലായിരുന്നു.",
   "start": 29.31,
   "end": 32.63
  },
  {
   "sec": "s4",
   "text": "ഏറ്റവും പ്രധാനം ഇതാണ്.",
   "start": 33.46,
   "end": 34.81
  },
  {
   "sec": "s4",
   "text": "മാസം അഞ്ഞൂറ് രൂപ ഞാൻ അപ്സ്കില്ലിങ്ങിന് മാറ്റി വെച്ചു, ഒരു ഓൺലൈൻ കോഴ്സിന്.",
   "start": 35.14,
   "end": 39.33
  },
  {
   "sec": "s4",
   "text": "ശമ്പളം കൂടണമെങ്കിൽ ഞാൻ വളരണം.",
   "start": 39.65,
   "end": 41.36
  },
  {
   "sec": "s4",
   "text": "കോഴ്സ് പഠിക്കുമ്പോൾ ജോലിയിൽ പുതിയ കാര്യങ്ങൾ ചെയ്യാൻ പറ്റും.",
   "start": 41.78,
   "end": 44.5
  },
  {
   "sec": "s4",
   "text": "പ്രമോഷൻ ഉറപ്പൊന്നുമില്ല, പക്ഷേ ശ്രമിക്കണം.",
   "start": 44.77,
   "end": 47.24
  },
  {
   "sec": "close",
   "text": "അടുത്ത മാസം ശമ്പളം പതിനഞ്ചിന് തീർന്നില്ല.",
   "start": 47.95,
   "end": 50.19
  },
  {
   "sec": "close",
   "text": "എഴുതി വെച്ചാൽ പൈസ എവിടെ പോകുന്നു എന്ന് കാണാം.",
   "start": 50.6,
   "end": 52.92
  },
  {
   "sec": "disc",
   "text": "ഇത് ഒരു ഉദാഹരണം മാത്രം, ഉപദേശമല്ല.",
   "start": 53.73,
   "end": 55.9
  }
 ]
}