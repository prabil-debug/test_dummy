{
 "total": 36.628,
 "items": [
  {
   "sec": "hook",
   "text": "ആദ്യത്തെ ശമ്പളം കിട്ടി.",
   "start": 0.3,
   "end": 1.367
  },
  {
   "sec": "hook",
   "text": "പുതിയ ഫോൺ വാങ്ങാൻ തോന്നി.",
   "start": 1.638,
   "end": 2.705
  },
  {
   "sec": "hook",
   "text": "പക്ഷേ ഞാൻ വാങ്ങിയില്ല.",
   "start": 2.949,
   "end": 4.315
  },
  {
   "sec": "hook",
   "text": "എന്തിനെന്ന് അറിയാമോ?",
   "start": 4.639,
   "end": 5.727
  },
  {
   "sec": "s1",
   "text": "ശമ്പളത്തിൽ നിന്ന് കുറച്ച് മാറ്റി വെച്ച് ഞാൻ ഒരു ഹെൽത്ത് ഇൻഷുറൻസ് എടുത്തു.",
   "start": 6.288,
   "end": 9.765
  },
  {
   "sec": "s1",
   "text": "ആശുപത്രി ബിൽ പറഞ്ഞിട്ട് വരില്ലല്ലോ.",
   "start": 10.071,
   "end": 11.596
  },
  {
   "sec": "s2",
   "text": "പിന്നെ ഓരോ മാസവും ചെറിയൊരു തുക മാറ്റി വെച്ചു.",
   "start": 12.201,
   "end": 14.612
  },
  {
   "sec": "s2",
   "text": "ചെറിയ തുകയാണ്, പക്ഷേ മുടക്കില്ല.",
   "start": 14.841,
   "end": 16.942
  },
  {
   "sec": "s3",
   "text": "രണ്ട് മൂന്ന് മാസത്തെ ശമ്പളത്തിന് തുല്യമായപ്പോൾ അത് എൻ്റെ എമർജൻസി ഫണ്ട് ആയി.",
   "start": 17.568,
   "end": 21.494
  },
  {
   "sec": "s3",
   "text": "ഇനി അത്യാവശ്യം വന്നാൽ ആരുടെയും മുന്നിൽ കൈ നീട്ടേണ്ട.",
   "start": 21.72,
   "end": 24.312
  },
  {
   "sec": "s4",
   "text": "ഫോൺ വേണ്ടേ?",
   "start": 24.927,
   "end": 25.513
  },
  {
   "sec": "s4",
   "text": "വേണം.",
   "start": 25.745,
   "end": 26.054
  },
  {
   "sec": "s4",
   "text": "പക്ഷേ ഇതിന് ശേഷം.",
   "start": 26.288,
   "end": 27.387
  },
  {
   "sec": "close",
   "text": "ഇനിയാണ് ശരിക്കുള്ള ചോദ്യം: ബാക്കി പണം എന്ത് ചെയ്യും?",
   "start": 28.001,
   "end": 30.987
  },
  {
   "sec": "close",
   "text": "അടുത്ത വീഡിയോയിൽ പറയാം.",
   "start": 31.34,
   "end": 32.684
  },
  {
   "sec": "disc",
   "text": "ഇത് ഒരു ഉദാഹരണം മാത്രം, ഉപദേശമല്ല.",
   "start": 33.252,
   "end": 35.428
  }
 ]
}