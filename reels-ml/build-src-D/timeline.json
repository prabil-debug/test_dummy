{
 "total": 41.043,
 "items": [
  {
   "sec": "hook",
   "text": "ആദ്യത്തെ ശമ്പളം, പതിനായിരം രൂപ.",
   "start": 0.3,
   "end": 1.996
  },
  {
   "sec": "hook",
   "text": "അത് എവിടെ പോയെന്ന് അറിയാമോ?",
   "start": 2.288,
   "end": 3.835
  },
  {
   "sec": "s1",
   "text": "കോഴിക്കോട് സൈബർ പാർക്കിൽ ആദ്യമായി പണിക്ക് കയറി.",
   "start": 4.469,
   "end": 6.89
  },
  {
   "sec": "s1",
   "text": "വലിയ ഐഡിയ ഒന്നും ഇല്ലായിരുന്നു, എങ്ങനെയൊക്കെയോ പണി പഠിച്ചു.",
   "start": 7.258,
   "end": 10.074
  },
  {
   "sec": "s2",
   "text": "ശമ്പളം കിട്ടി.",
   "start": 10.694,
   "end": 11.377
  },
  {
   "sec": "s2",
   "text": "അച്ഛന് ഒരു മുണ്ട്, അമ്മയ്ക്ക് ഒരു ബാഗും സാരിയും.",
   "start": 11.678,
   "end": 14.334
  },
  {
   "sec": "s3",
   "text": "കയ്യിൽ നോക്കിയപ്പോൾ വലുതായിട്ടൊന്നും ബാക്കിയില്ല.",
   "start": 14.972,
   "end": 17.255
  },
  {
   "sec": "s3",
   "text": "എന്നാലും കുറച്ച് പൈസ ഹെൽത്ത് ഇൻഷുറൻസിന് മാറ്റി വെച്ചു.",
   "start": 17.504,
   "end": 20.363
  },
  {
   "sec": "s3",
   "text": "എപ്പോഴാ പണി വരികയെന്ന് അറിയില്ലല്ലോ.",
   "start": 20.665,
   "end": 22.372
  },
  {
   "sec": "s4",
   "text": "ബാക്കി പൈസ എന്ത് ചെയ്യണമെന്ന് ഒരു ഐഡിയയും ഇല്ല.",
   "start": 23.016,
   "end": 25.501
  },
  {
   "sec": "s4",
   "text": "ഇത്രയും പൈസ കയ്യിൽ കിട്ടുന്നത് ആദ്യമായിട്ടല്ലേ.",
   "start": 25.848,
   "end": 28.27
  },
  {
   "sec": "s5",
   "text": "പിന്നെ ഒന്നും നോക്കിയില്ല.",
   "start": 28.834,
   "end": 30.231
  },
  {
   "sec": "s5",
   "text": "ഫ്രണ്ട്സിനെയും കൂട്ടി നല്ലൊരു ബിരിയാണി അടിച്ചു.",
   "start": 30.5,
   "end": 32.665
  },
  {
   "sec": "close",
   "text": "അടുത്ത മാസം ഞാൻ ചെയ്തത് വേറെ ഒന്നാണ്.",
   "start": 33.229,
   "end": 35.287
  },
  {
   "sec": "close",
   "text": "അടുത്ത വീഡിയോയിൽ പറയാം.",
   "start": 35.637,
   "end": 36.981
  },
  {
   "sec": "disc",
   "text": "ഇത് പൊതുവായ അറിവ് മാത്രം, ഉപദേശമല്ല.",
   "start": 37.635,
   "end": 39.843
  }
 ]
}